generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum SubscriberStatus {
  ACTIVE
  EXPIRED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
  EXPIRED
}

enum EventType {
  SENT
  DELIVERED
  CLICKED
  DISMISSED
  SUBSCRIBED
  UNSUBSCRIBED
  PROMPT_SHOWN
  PROMPT_ACCEPTED
  FAILED
  // Soft-prompt funnel steps between SHOWN and ACCEPTED (2026-10-15), so the
  // losing step is measurable: tapped "Allow", said no (No thanks / × / Esc),
  // or the browser's own prompt came back denied / unanswered.
  PROMPT_ALLOW_CLICKED
  PROMPT_DECLINED
  PROMPT_BLOCKED
  PROMPT_IGNORED
}

enum UserRole {
  ADMIN
  PUBLISHER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  USER_CREATED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_ROLE_CHANGED
  USER_PASSWORD_RESET
  USER_INVITED
  USER_INVITE_ACCEPTED
  CAMPAIGN_DISPATCHED
  CAMPAIGN_DISPATCH_FAILED
  REVIEW_APPROVED
  REVIEW_REJECTED
  REVIEW_PUSHED
  // Email digest (docs/EMAIL_DIGEST_DESIGN.md §6)
  DIGEST_APPROVED
  DIGEST_HELD
  DIGEST_SEND_NOW
  DIGEST_RETRY
  DIGEST_TEST_SENT
  DIGEST_SUBJECT_EDITED
  DIGEST_SCHEDULED
  DIGEST_SKIPPED
  DIGEST_TEMPLATE_SAVED
  DIGEST_TEMPLATE_ACTIVATED
  DIGEST_TEMPLATE_ARCHIVED
  DIGEST_TEMPLATE_REVERTED
  DIGEST_AD_SAVED
  DIGEST_AD_ARCHIVED
  // Staff push devices (digest task 14): an approver's own device, never a reader
  STAFF_PUSH_SUBSCRIBED
  STAFF_PUSH_UNSUBSCRIBED
  STAFF_PUSH_REMOVED
  // CMS audience sync (docs/CMS_AUDIENCE_SYNC_DESIGN.md §10.2). Counts / a hash only — never an address
  AUDIENCE_SYNC_RESUMED
  AUDIENCE_FULL_LOAD
  AUDIENCE_ERASURE
  AUDIENCE_RESUBSCRIBED
  // CMS views (Feed 2): an admin started the history backfill (range + dryRun only)
  CMS_VIEWS_BACKFILL_STARTED
}

model Subscriber {
  id        String           @id @default(cuid())
  portal    String           @default("taxscan")
  endpoint  String           @unique
  p256dh    String
  auth      String
  topics    String[]
  userAgent String?
  status    SubscriberStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  events Event[]

  @@index([portal])
  @@index([status])
}

model Campaign {
  id              String         @id @default(cuid())
  portal          String
  title           String
  body            String
  url             String
  icon            String?
  target          Json
  scheduledAt     DateTime?
  status          CampaignStatus @default(DRAFT)
  createdAt       DateTime       @default(now())
  createdByUserId String?

  // Editorial pacing (SEND_PACING_PLAN.md). Set by the RSS poller's classifier:
  // QUALIFIED (allow-list, auto-eligible) / FALLBACK (ITAT/CESTAT/NCLAT/NCLT —
  // filler only) / REVIEW (unclassified, awaiting an editor). Null for manual
  // /api/send campaigns and legacy rows. `authority` is the matched source
  // (e.g. "CESTAT", "Supreme Court") for ranking + display.
  sendQueue  SendQueue?
  authority  String?
  // The article's RSS <category> tags (e.g. ["Income Tax","Top Stories"]),
  // captured for the weekly/monthly coverage reports. Empty for manual sends.
  categories String[]   @default([])
  // Set when an editor handles a REVIEW item (approve / reject / push-now). A
  // REVIEW DRAFT with reviewedAt = null is still pending in the review queue.
  reviewedAt DateTime?

  // Event rows the retention sweeper has already folded in and DELETED for
  // this campaign (src/sweepers/eventRetention.ts). Every per-campaign figure
  // is `rolled + a live count of the rows that remain` — see campaignStats()
  // in src/services/metrics.ts. Zero until the sweeper first touches the
  // campaign; the send path never writes these.
  rolledSent        Int       @default(0)
  rolledClicked     Int       @default(0)
  rolledFailed      Int       @default(0)
  rolledFirstSentAt DateTime?
  /// When this campaign was last dispatched. Stamped by executeCampaign when it
  /// marks the campaign SENT, so "recently pushed" (Dashboard, Campaigns list)
  /// reads a handful of indexed Campaign rows instead of grouping a week or two
  /// of delivery Events (~460k-900k rows; the cold-cache cause of slow loads).
  lastSentAt        DateTime?
  /// One-time id the admin SPA attaches to a Compose send. A second /api/send
  /// carrying the same id (a retry after a timeout, a double click) is refused
  /// instead of pushing the same message to every subscriber twice. Null for
  /// RSS captures, bearer/curl sends and rows from before 2026-10-21.
  clientRequestId   String?   @unique
  /// When the pacer or a Queue "Push now" claimed this row (DRAFT → SCHEDULED
  /// with scheduledAt = null) to send it. A row still SCHEDULED long after this
  /// means the process died mid-send; recoverStrandedClaims() closes it out as
  /// SENT or FAILED — never re-sends it. Null for every other path.
  claimedAt         DateTime?

  createdBy   User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  events      Event[]
  feedItems   FeedItem[]
  digestItems DigestItem[]

  @@index([portal])
  @@index([status])
  @@index([scheduledAt])
  @@index([sendQueue])
  @@index([lastSentAt])
}

enum SendQueue {
  QUALIFIED
  FALLBACK
  REVIEW
}

// Internal report-only recipients: emails that receive the weekly/monthly
// coverage report but have no login and no push subscription. App users (the
// User table) also receive it via their email; this is for extra internal members.
model ReportRecipient {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  role                  UserRole
  isActive              Boolean   @default(true)
  passwordResetRequired Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastLoginAt           DateTime?

  sessions    UserSession[]
  auditLogs   AuditLog[]
  campaigns   Campaign[]
  invitesSent UserInvite[]            @relation("InvitesSent")
  pushDevices StaffPushSubscription[]
}

// A staff member's own browser or phone, opted in from the admin ("Notify me on
// this device", digest task 14) to get the digest's approval notifications.
// NOT a reader: its own table, so it is never counted in subscriber metrics,
// never selected by the pacer / Compose / sweeper / Push now (they all read
// `Subscriber`), and never in the R2 backup (a device re-subscribes with one
// tap; see src/services/backup.ts). One row per push endpoint — re-subscribing
// the same browser updates it, even under another login. A deactivated user's
// rows are deleted; sending also filters on User.isActive. Never log `endpoint`.
model StaffPushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  // Short device label from the user agent ("Chrome on Android"), shown to admins.
  label         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  // Consecutive failed deliveries (reset on success). 404/410 deletes the row instead.
  failureCount  Int       @default(0)

  @@index([userId])
}

// A pending invitation to join the admin. The real `User` row is created
// only when the recipient accepts (Phase 8). Until then this is the sole
// record of the invite — keyed by a single-use token whose SHA-256 hash is
// stored (same model as UserSession.tokenHash). `acceptedAt` is set when the
// invite is consumed; revoking deletes the row outright.
model UserInvite {
  id              String    @id @default(cuid())
  email           String
  role            UserRole
  tokenHash       String    @unique
  expiresAt       DateTime
  invitedByUserId String?
  invitedBy       User?     @relation("InvitesSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedAt      DateTime?
  acceptedUserId  String?
  createdAt       DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       AuditAction
  resourceType String?
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// Per-article read counts synced from the GA4 Data API (src/services/gaReads.ts).
// One row per (portal, pagePath, date): `totalViews` = all pageviews GA saw for
// that path that day; `pushViews` = the subset from sessions GA attributes to our
// push UTM (sessionSource = taxscan-push). Written ONLY by the flag-gated sync
// cron — the request path (reports/campaigns) reads Postgres and never calls GA,
// so a GA outage just leaves counts stale, it can't slow or break the app.
model ArticleReadStat {
  id         String   @id @default(cuid())
  portal     String   @default("taxscan")
  pagePath   String
  date       DateTime @db.Date
  totalViews Int      @default(0)
  pushViews  Int      @default(0)
  fetchedAt  DateTime @default(now()) @updatedAt

  @@unique([portal, pagePath, date])
  @@index([date])
  @@index([pagePath])
}

// Which Google surface an article was picked up by. Kept as an enum rather
// than a free string so a typo can't silently create a third, empty surface.
enum SearchSurface {
  DISCOVER
  GOOGLE_NEWS
}

// Per-article Discover / Google News performance, synced from the Search
// Console Search Analytics API (src/services/searchSurfaces.ts). One row per
// (portal, pagePath, date, surface).
//
// WHY SEARCH CONSOLE AND NOT GA4: Discover is invisible to GA4 — its clicks
// carry a plain google.com referrer, so they land in `google / organic`
// alongside ordinary search (or in `(direct)` when the Google app strips the
// referrer). Search Console's API is the only source that separates the
// surfaces, via its `type` parameter (discover / googleNews).
//
// These are CLICKS AND IMPRESSIONS, not pageviews — they are NOT comparable
// with ArticleReadStat.totalViews and must never be summed with it. Google
// also reports against the CANONICAL url and settles 2-3 days late, which is
// why this data is only ever shown in retrospective (trailing-window) views.
model ArticleSurfaceStat {
  id          String        @id @default(cuid())
  portal      String        @default("taxscan")
  pagePath    String
  date        DateTime      @db.Date
  surface     SearchSurface
  clicks      Int           @default(0)
  impressions Int           @default(0)
  fetchedAt   DateTime      @default(now()) @updatedAt

  @@unique([portal, pagePath, date, surface])
  @@index([date])
  @@index([pagePath])
  @@index([surface])
}

// Cached "Reads" report: bench×window + category×window pageview aggregates
// over trailing windows (1w/1m/3m/6m/12m), built by src/services/readsReport.ts
// from the GA4 Data API on a daily cron. One row per portal — the API serves
// this row directly and never calls GA at request time, so the screen loads
// instantly and a GA outage only means the report stays at its last build.
/// Per-article, per-IST-day views mirrored from the CMS's Feed 2 (GET /api/v1/push-feed/article-views, contract
/// A.8; src/services/cmsViews/). Filled ONLY by the sync cron / backfill: the request path never calls the CMS.
/// `pushViews` / `digestViews` are NULL before 2026-10-15 (no source was recorded then): null is "unknown", not 0.
/// `canonicalPath` = the path of `canonical_url` (trailing slash dropped); `externalId` = the old CMS's numeric
/// news id for a migrated story. Grows ~thousands of rows a day (see the REPORT for sizes).
model CmsArticleView {
  id            String   @id @default(cuid())
  portal        String   @default("taxscan")
  articleId     String
  canonicalPath String
  externalId    String?
  date          DateTime @db.Date
  views         Int
  pushViews     Int?
  digestViews   Int?
  cmsUpdatedAt  DateTime
  fetchedAt     DateTime @default(now())

  @@unique([portal, articleId, date])
  @@index([portal, canonicalPath, date])
  @@index([portal, externalId, date])
  @@index([portal, date])
}

model GaReadsReport {
  id          String   @id @default(cuid())
  portal      String   @unique
  payload     Json
  generatedAt DateTime @default(now()) @updatedAt
}

model FeedItem {
  id         String   @id @default(cuid())
  feedUrl    String
  guid       String   @unique
  campaignId String?
  createdAt  DateTime @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([feedUrl])
}

model Event {
  id           String    @id @default(cuid())
  campaignId   String?
  subscriberId String?
  type         EventType
  meta         Json?
  createdAt    DateTime  @default(now())

  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  subscriber Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([subscriberId])
  @@index([type])
  @@index([createdAt])
}

/// One row per SCHEDULED coverage-report email run (weekly/monthly).
///
/// Exists so a failed run is visible in the product instead of only in the
/// deploy logs: on 2026-08-31 and 2026-09-01 every send failed with
/// "plan expired" at the email provider and nobody noticed for a week.
/// The Reports screen reads the newest row and warns while `failed > 0`.
///
/// Deliberately NOT written by the "Email me a test" route — a personal
/// preview must not overwrite the standing state of the scheduled send.
model ReportEmailRun {
  id         String   @id @default(cuid())
  portal     String
  period     String
  ranAt      DateTime @default(now())
  recipients Int
  sent       Int
  failed     Int
  /// First provider error of the run, truncated. Null when nothing failed.
  error      String?

  @@index([portal, ranAt])
}

/// One row per off-platform backup run (src/services/backup.ts).
///
/// Same reasoning as ReportEmailRun: a scheduled job whose only failure signal
/// is a console line is a job nobody notices has stopped. The Dashboard reads
/// the newest row and warns when the last run failed or is overdue.
model BackupRun {
  id        String   @id @default(cuid())
  ranAt     DateTime @default(now())
  /// Object key written to the bucket; null when the run failed before upload.
  objectKey String?
  rows      Int
  bytes     Int
  /// Per-table row counts, for spotting a table that silently stopped exporting.
  tables    Json
  ok        Boolean
  error     String?

  @@index([ranAt])
}

/// Lifetime count of Event rows the retention sweeper has deleted, per type.
///
/// Dashboard lifetime totals are `this + a live count of remaining rows`,
/// which stays exact as the raw table is bounded to a rolling window. One row
/// per EventType, written only by the sweeper, inside the same transaction as
/// the delete. Included in the off-platform backup: once the rows are gone
/// these numbers cannot be re-derived.
model EventRollup {
  id        String    @id @default(cuid())
  type      EventType @unique
  count     Int       @default(0)
  updatedAt DateTime  @default(now()) @updatedAt
}

// ---------------------------------------------------------------------------
// Automatic daily email digest (docs/EMAIL_DIGEST_DESIGN.md §3). Task 1 adds
// only the run + per-audience send rows; items, templates, ads, webhook events
// and suppressions arrive with the tasks that read them. Never touches Event.
// ---------------------------------------------------------------------------

enum DigestAudience {
  FREE
  PREMIUM
}

enum DigestBuild {
  BUILDING
  BUILT
  BUILD_FAILED
  SKIPPED
}

enum DigestApproval {
  NOT_REQUIRED
  PENDING
  APPROVED
  HELD
}

enum DigestSendState {
  PENDING
  CREATED
  SCHEDULED
  SENT
  PARTIALLY_SENT
  FAILED
  SKIPPED
}

enum SenderErrorKind {
  RETRYABLE
  FATAL
  AMBIGUOUS
}

/// One per IST calendar day. The unique (portal, runDate) IS the "max one per day" rule.
model DigestRun {
  id                  String         @id @default(cuid())
  portal              String         @default("taxscan")
  runDate             DateTime       @db.Date // IST date
  windowStart         DateTime // = previous run's builtAt (cap 72 h)
  builtAt             DateTime? // freeze instant = next run's windowStart
  build               DigestBuild    @default(BUILDING)
  // too_little_news | cutoff_passed | not_approved | held_by_editor |
  // build_failed | config_invalid | sanity_hold_expired
  skipReason          String?
  approval            DigestApproval @default(NOT_REQUIRED)
  approvedByUserId    String?
  approvedAt          DateTime?
  candidateCount      Int            @default(0) // for the re-platform sanity guard
  healthOk            Boolean?
  healthCheckedAt     DateTime?
  healthError         String?
  alerts              Json           @default("{}") // {kind: sentAt}, so one alert per kind per run
  // Task 4: whether organic read rate ranked items within a queue+tier, from which
  // source (ga | cms), and why not when it did not (flag off, stale data, …).
  readsUsed           Boolean?
  readsSource         String?
  readsNote           String?
  // Build retry bookkeeping (task 9 follow-ups, 2026-10-23): a failed build is retried
  // on the retry policy (+1, +5, +15, then +75, +135 … min from the first failure),
  // not every tick. Retry now skips the wait. Cleared when the run builds.
  buildAttempts       Int            @default(0)
  buildFirstFailureAt DateTime?
  buildNextAttemptAt  DateTime?
  // The CURRENT reason the build is failing (ads_unfillable | build_error) and its
  // plain-words detail (unfillable slots, or the redacted error). The cut-off and the
  // banner read these, never the once-per-run alert markers. Null once built.
  buildFailure        String?
  buildError          String?
  // Task 13 (scheduler + health): the complaint-rate check of the previous send, taken once
  // when this run is created ({checkedAt, thresholdPct, held, previousRunDate, sends: [{audience,
  // complaints, delivered, ratePct}]}; a null count/rate = UNKNOWN, never 0). held = true makes
  // this run need an editor's approval even when DIGEST_APPROVAL_REQUIRED is off.
  complaintCheck      Json?
  // Task 13: the once-a-day Mailercloud webhook status read (GET /v1/webhooks/detail/{id},
  // only with MAILERCLOUD_WEBHOOK_ID). webhookActive null = not read (or unreadable) today.
  webhookCheckedAt    DateTime?
  webhookActive       Boolean?
  createdAt           DateTime       @default(now())

  sends DigestSend[]
  items DigestItem[]

  @@unique([portal, runDate])
}

/// One per (run, audience): each variant is its own provider campaign with its own state.
model DigestSend {
  id                     String           @id @default(cuid())
  runId                  String
  audience               DigestAudience
  state                  DigestSendState  @default(PENDING)
  templateId             String?
  subject                String
  preheader              String
  html                   String? // FROZEN at build; nulled after DIGEST_HTML_RETENTION_DAYS
  text                   String?
  htmlBytes              Int
  mcCampaignName         String           @unique // TS-DIGEST-2026-10-23-FREE (rows before 2026-10-23: …-FREE-<runId>)
  mcCampaignId           String?          @unique // persisted the instant create returns
  sendAfter              DateTime // planned send instant (Send now moves it earlier)
  scheduledAt            DateTime? // when we called schedule
  sentConfirmedAt        DateTime?
  sentVia                String? // status_poll | webhook
  stepClaimedAt          DateTime? // DB claim; protects against two containers mid-deploy
  // Write-ahead markers, set in the claim update BEFORE the provider call. A set
  // marker means the call may have happened: ask the provider before repeating it.
  createAttemptedAt      DateTime?
  scheduleAttemptedAt    DateTime?
  // Written (fenced on the claim) immediately BEFORE the createDraft() HTTP call, i.e. after
  // the name lookup proved no campaign exists. Set = this database actually called create, so
  // a draft found later by name is ours (decision A). `createAttemptedAt` only says the step
  // was claimed: a crash before the call leaves it set but this one null (2026-10-23).
  createSentAt           DateTime?
  attempts               Int              @default(0) // all failed attempts (display)
  firstFailureAt         DateTime? // first failure of any step (display)
  // Retry bookkeeping for the CURRENT step (create or schedule); reset when the step succeeds.
  stepAttempts           Int              @default(0)
  stepFirstFailureAt     DateTime?
  nextAttemptAt          DateTime?
  lastError              String? // truncated, email-shaped substrings redacted
  lastErrorKind          SenderErrorKind?
  targeted               Int? // from the provider report
  reached                Int?
  opens                  Int? // aggregate from the report API, trend only
  clicks                 Int?
  rolledUnsub            Int              @default(0) // EmailEvent rows folded by the sweeper
  rolledBounce           Int              @default(0)
  rolledSpam             Int              @default(0)
  // Set when this variant was frozen WITHOUT content because its ad slots could not be
  // filled while the other audience's could (task 9 follow-ups): the run's stories are
  // frozen, this variant's html is rendered from them once ads are fixed (state FAILED,
  // lastError "ads_unfillable: …" until then). Null for every normally built variant.
  contentPendingAt       DateTime?
  // Owner, 2026-10-23: a variant rendered AFTER the build (the contentPendingAt path) is
  // never covered by the run's approval — in approval mode it needs its own (approvedAt).
  // False for every variant frozen at the build (the run approval covers those).
  ownApprovalRequired    Boolean          @default(false)
  approvedAt             DateTime?
  approvedByUserId       String?
  // Owner, 2026-10-23: the custom template failed at send time, so this variant was
  // rendered with the built-in template (templateId null). The template it fell back from
  // and why (RenderError text, redacted). Null when no fallback happened.
  templateFallbackFromId String?
  templateFallbackReason String?
  // Task 11 (retention): stamped by the nightly fold when it deletes this send's
  // campaign_sent / campaign_error events, so the "the webhook was receiving" proof that
  // digestSendStats() needs outlives the events themselves (else old sends turn to "—").
  webhookProofAt         DateTime?
  // Task 11: when the frozen html/text were nulled (DIGEST_HTML_RETENTION_DAYS). Null = still stored.
  htmlPurgedAt           DateTime?
  // Task 13, owner decision A (2026-10-23): set when this variant ADOPTED a campaign that
  // Mailercloud already had as a DRAFT (or whose status could not be read) — e.g. after a
  // database restore. Its content cannot be confirmed to match our frozen html, so it is
  // never scheduled without a person's approval (ownApprovalRequired), in any mode.
  adoptedDraftAt         DateTime?

  run        DigestRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  placements DigestAdPlacement[]

  @@unique([runId, audience])
  @@index([state, nextAttemptAt])
}

/// The frozen story list (task 4). Keyed by articleKey (taxscan's trailing id), NOT by GUID or
/// Campaign id, so a re-GUID'd or re-captured article still dedupes against earlier digests.
/// Written once, in the same transaction that freezes the run; never updated afterwards.
model DigestItem {
  id         String          @id @default(cuid())
  runId      String
  rank       Int // 1-based within the audience's list: MAIN first, then ICYMI
  section    String // MAIN | ICYMI
  audience   DigestAudience? // null = both; set when the two variants' lists differ
  articleKey String
  campaignId String? // provenance; SetNull if the Campaign row goes
  title      String
  url        String
  authority  String?
  category   String // reportCategory(), the coverage report's own rule
  excerpt    String?
  capturedAt DateTime
  /// Organic reads per hour since capture used for within-tier ranking; null when the
  /// item was too fresh to judge, reads were not used, or it is a roll-forward item.
  readRate   Float?
  /// The story's picture (the article page's og:image, read at the build; documents.taxscan.in .jpg/.jpeg/.png only). null = text-only.
  imageUrl   String?

  run      DigestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([runId, articleKey, audience])
  @@index([articleKey])
  @@index([campaignId])
}

/// Mailercloud webhook events (task 8). NO email address is ever stored here: `emailHash` is
/// sha256 of the normalised (trimmed, lowercased) address, kept only for dedupe and per-reader
/// joins later. `dedupeKey` is unique, so a provider retry or a replayed payload inserts once.
/// Kept 90 days, then folded into DigestSend.rolled* (task 11); `digestSendStats()` is the single
/// rolled + live implementation.
model EmailEvent {
  id           String   @id @default(cuid())
  provider     String   @default("mailercloud")
  type         String // UNSUBSCRIBE | HARD_BOUNCE | SPAM | CAMPAIGN_SENT | CAMPAIGN_ERROR | NO_ADDRESS (daily signal, no PII)
  mcCampaignId String?
  sendId       String? // DigestSend.id when the campaign is one of ours; null for other campaigns
  emailHash    String? // sha256(normalised address); never the address
  dedupeKey    String   @unique
  meta         Json? // provider event name, event time, redacted error text — never an address
  receivedAt   DateTime @default(now())

  @@index([sendId])
  @@index([receivedAt])
  @@index([mcCampaignId])
}

/// Our copy of who must not be mailed (task 8). Mailercloud enforces its own list for campaigns;
/// this copy is what future lifecycle sends check and what restores opt-outs after a disaster.
/// Never deleted automatically. `email` is NEVER logged and is shown as a count only.
///
/// CMS audience sync (docs/CMS_AUDIENCE_SYNC_DESIGN.md §4, §6.3): `email` is NULLABLE so an erasure
/// (`account.deleted`) can drop the address while `emailHash` + `accountId` keep the opt-out
/// matching. Until audience task 3 writes them, both new columns are null on every row.
model EmailSuppression {
  id          String   @id @default(cuid())
  email       String?  @unique // normalised: trimmed, lowercase; null only after a CMS erasure
  emailHash   String?  @unique // sha256(normalised address); kept after erasure
  accountId   String? // CMS account_id the opt-out also follows (email change, erasure)
  reason      String // UNSUBSCRIBE | HARD_BOUNCE | SPAM | MANUAL — escalates SPAM > HARD_BOUNCE > UNSUBSCRIBE, never down; MANUAL is never rewritten
  source      String // mailercloud_webhook | manual
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([accountId])
}

/// House ads for the digest (task 9; docs/EMAIL_DIGEST_DESIGN.md §3, §4 ads.ts, §7, §9). Only
/// taxscan's own products. Archived, never deleted. `pickAds()` in services/digest/ads.ts is the
/// single eligibility rule; `kind = SUBSCRIPTION` is NEVER placed in a PREMIUM send whatever
/// `audience` says (checked at pick, at render and again at freeze). `portal` scopes the pool
/// (portal-agnostic like DigestRun; also isolates test pools).
/// Task 10: the email layouts (docs/EMAIL_DIGEST_DESIGN.md §3, §13 task 10). DRAFT → ACTIVE →
/// ARCHIVED, plus SCHEDULED = a dated override that wins inside [startsAt, endsAt). The DATABASE
/// enforces "one ACTIVE per audience": a partial unique index in raw SQL in the migration
/// (`one_active_template_per_audience` ON (portal, audience) WHERE status = 'ACTIVE'), plus CHECK
/// constraints on status/format and the override window. Prisma does not model either: never
/// accept a generated migration that drops them. No template row = the built-in template.
model DigestTemplate {
  id              String         @id @default(cuid())
  portal          String         @default("taxscan")
  name            String
  audience        DigestAudience
  status          String         @default("DRAFT") // DRAFT | ACTIVE | SCHEDULED | ARCHIVED
  format          String         @default("HTML") // HTML | MJML (MJML compiles at save time only)
  source          String
  compiledHtml    String? // compiled at SAVE time; the send path never compiles. Null when it failed
  compileError    String? // the compiler's readable message; blocks activation
  validation      Json           @default("{}") // the last checklist result (validateTemplate)
  validatedAt     DateTime?
  startsAt        DateTime? // SCHEDULED overrides only (e.g. Budget week); inclusive
  endsAt          DateTime? // exclusive
  replacesId      String? // the ACTIVE template this one displaced; Revert restores it
  activatedAt     DateTime?
  archivedAt      DateTime?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([portal, audience, status])
}

model DigestAd {
  id              String    @id @default(cuid())
  portal          String    @default("taxscan")
  name            String
  kind            String // HOUSE | SUBSCRIPTION | RENEWAL
  headline        String // live text, never only inside the image
  altText         String
  body            String?
  ctaText         String
  linkUrl         String // passes isAllowedPushUrl() at save AND at render; UTM added at render, never stored
  imageId         String? // the desktop banner (shown 860 px wide; 1720 × 400 px for new ads)
  mobileImageId   String? // the mobile square (1080 × 1080 px, shown 300 px wide on phones); null = phones get the banner
  audience        String // ALL | FREE_ONLY | PREMIUM_ONLY
  topic           String? // matched against the lead items' report category (ordering only)
  slots           Int[] // empty = any slot
  priority        Int       @default(0)
  isSlotDefault   Boolean   @default(false) // fallback for its slots when nothing else is eligible
  startsAt        DateTime?
  endsAt          DateTime?
  status          String // ACTIVE | PAUSED | ARCHIVED
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  image       DigestAdImage?      @relation("DigestAdImage", fields: [imageId], references: [id])
  mobileImage DigestAdImage?      @relation("DigestAdMobileImage", fields: [mobileImageId], references: [id])
  placements  DigestAdPlacement[]

  @@index([portal, status])
}

/// One scalable creative (≤ 1200 px wide, ≤ 150 KB, JPEG or PNG — validated from the bytes, never
/// resized). `id` = sha256 of the bytes, so an identical upload is the same row. Served publicly at
/// /email-assets/<id>.<jpg|png> with an immutable cache.
/// Single-value digest settings (key = "<portal>:<name>"). First use: "<portal>:defaultStoryImage" = the
/// DigestAdImage id of the 1600 x 840 default story picture. No FK on purpose (the value is a plain string
/// that is checked when read); backed up (format v2).
model DigestSetting {
  id              String   @id @default(cuid()) // the backup export pages by id
  key             String   @unique
  value           String
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
}

model DigestAdImage {
  id        String   @id // sha256 hex of the bytes
  mime      String // image/jpeg | image/png (sniffed, not declared)
  width     Int
  height    Int
  size      Int
  bytes     Bytes
  createdAt DateTime @default(now())

  ads       DigestAd[] @relation("DigestAdImage")
  mobileAds DigestAd[] @relation("DigestAdMobileImage")
}

/// One row per ad per send (task 9): rotation (least recently placed) and, later, order matching.
model DigestAdPlacement {
  id         String   @id @default(cuid())
  sendId     String
  adId       String
  slot       Int
  utmContent String // ad-<id>-slot<N>
  createdAt  DateTime @default(now())

  send DigestSend @relation(fields: [sendId], references: [id], onDelete: Cascade)
  ad   DigestAd   @relation(fields: [adId], references: [id])

  @@unique([sendId, slot])
  @@index([adId, createdAt])
}

// ─── CMS audience sync (docs/CMS_AUDIENCE_SYNC_DESIGN.md §4; CMS push-feed contract v1.1) ───
// Every flag defaults OFF (AUDIENCE_SYNC_ENABLED …). Nothing reads or writes these tables until
// audience task 3; this migration only creates them.

/// Mirror of the CMS reader accounts. NO address, NO name: `emailHash` finds the member row.
/// `applyAccountSnapshot()` (task 3) is the only writer; higher `seq` wins.
model CmsAccount {
  accountId     String    @id // CMS account_id (a string)
  portal        String    @default("taxscan")
  seq           BigInt // last applied
  status        String // free|active|cancelled|ended|deleted|<unknown kept verbatim>
  plan          String?
  periodEnd     DateTime? @db.Date
  consentValue  Boolean? // raw tri-state marketing_consent.value
  consentAt     DateTime?
  emailHash     String? // sha256(normalised email); null once deleted, or when the CMS withholds the email (Q10)
  deletedAt     DateTime? // tombstone: blocks late lower-seq events
  erasedAt      DateTime? // contract v1.2 `account.deleted` + `erasure: true`: never reactivated
  unknownStatus String? // the last snapshot's status when not a known one (`status` keeps the last KNOWN)
  outOfScopeAt  DateTime? // task 5 absence rule: missing from a COMPLETE full load → ignored by memberRole until any snapshot names it again
  lastSource    String // webhook|pull_incr|pull_full
  updatedAt     DateTime  @updatedAt

  @@index([emailHash])
  @@index([status])
}

/// One row per ADDRESS in a mailed role (PREMIUM / FORMER / noMarketing / mid clean-up), the only
/// place an address lives. Deleted once desiredRole = NONE and appliedTags = []. `email` is never
/// logged and is stripped from backups; null after an erasure.
model AudienceMember {
  emailHash          String    @id
  email              String? // normalised; NEVER logged; not in backups
  desiredRole        String // PREMIUM | FORMER | NONE (memberRole(), the single definition)
  noMarketing        Boolean   @default(false) // any linked account said consent=false
  suppressed         Boolean   @default(false) // EmailSuppression by address OR by any linked accountId
  appliedTags        String[]  @default([]) // what Mailercloud has acknowledged; [] = nothing of ours
  mcState            String    @default("UNKNOWN") // UNKNOWN | ABSENT | PRESENT (from our own GET)
  attempts           Int       @default(0)
  nextAttemptAt      DateTime?
  lastErrorKind      String? // RETRYABLE | FATAL — never a provider message
  syncedAt           DateTime?
  resubscribePending Boolean   @default(false) // ingest lifted a suppression on this address; held (with the address) until the writer has handled the lift
  eraseRequestedAt   DateTime? // UNUSED since 24 Oct (owner: the CMS erases in Mailercloud; we null `email` at ingest). Kept: migrations are additive-only
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([nextAttemptAt])
  @@index([desiredRole])
}

/// Door W replay/dedupe (contract v1.1 §3): `eventId` (= X-CMS-Event-Id = body event_id) →
/// the signed timestamp. Same id + same ts = an exact replay (401); same id + newer ts = the CMS's
/// own retry (2xx, not applied again). Written only after the signature verifies. 30 days.
model CmsEventReceipt {
  eventId    String   @id
  event      String
  signedTs   BigInt // X-CMS-Timestamp of the first accepted delivery (unix seconds)
  outcome    String // applied | stale_seq | unknown_type | invalid
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

/// One row per portal; read by the send guard, the Audience card and alerts.
model AudienceSyncState {
  portal           String    @id
  lastFullAsOf     DateTime?
  lastFullOkAt     DateTime?
  lastIncrAsOf     DateTime?
  lastIncrOkAt     DateTime?
  lastWebhookAt    DateTime?
  cmsCounts        Json      @default("{}") // from the last COMPLETE full load: {active,cancelled,free,ended}
  breakerOpenAt    DateTime? // Mailercloud writes paused
  breakerReason    String? // change_too_large | truncated_load | erasure_cap | ...
  pendingReview    Json? // counts only, shown to the ADMIN who resumes
  lastFullRowCount Int? // rows in the last COMPLETE full load (the 90% acceptance rule and the scope-change check)
  counters         Json      @default("{}") // {day, seqConflict, unknownStatus, removals:[{at,n}]} — daily alerts + the 24 h Premium-removal breaker
  drift            Json? // last nightly drift check: {at, sampled, mismatched, premiumOurs, premiumMailercloud}
  alerts           Json      @default("{}") // {kind: {raisedAt, day, emailedAt, emailAttempts, …counts}} — audience alerts, once per kind per IST day
  updatedAt        DateTime  @updatedAt
}
